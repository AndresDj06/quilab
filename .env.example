APP_NAME=QUILAB
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_SUBDIRECTORY=
ASSET_URL=

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quilab
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:80,localhost:8000,localhost:5173,127.0.0.1,127.0.0.1:80,127.0.0.1:8000,quilab.co,www.quilab.co
FRONTEND_URL=http://localhost:5173

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hola@quilab.dev"
MAIL_FROM_NAME="${APP_NAME}"

QUILAB_CONTACT_EMAIL=hola@quilab.dev

VITE_APP_NAME="${APP_NAME}"
